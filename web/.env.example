# --- Privy (https://dashboard.privy.io) ---
# Aktifkan: Login Google (+ Email, Wallet), Embedded wallets. Tambahkan http://localhost:3000 dan domain Vercel ke Allowed origins.
NEXT_PUBLIC_PRIVY_APP_ID=

# RPC Arbitrum Sepolia (opsional, default RPC publik)
NEXT_PUBLIC_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# --- Gas sponsor (server-side, JANGAN pakai prefix NEXT_PUBLIC) ---
# Private key wallet testnet khusus yang berisi ETH Arbitrum Sepolia. Dipakai /api/gas-drip untuk mengirim gas awal ke pengguna baru.
SPONSOR_PRIVATE_KEY=
# Jumlah ETH per drip dan batas saldo di bawah mana drip diberikan
GAS_DRIP_ETH=0.0008
GAS_DRIP_THRESHOLD_ETH=0.0002
